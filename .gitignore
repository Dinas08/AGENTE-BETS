# Segredos (chave da API, palavra-passe) — nunca vão para o GitHub
.env
.streamlit/secrets.toml

# Ambiente Python e caches
.venv/
__pycache__/
*.pyc

# Vídeos: modelo de voz local (63 MB) e cache das vozes geradas
docs/video/vozes/
docs/video/cache_voz/

# Os dados vivem no ramo "claude/dados" (ver scripts/guardar_dados.sh)
dados/

# Vídeos renderizados e amostras (só o motor, as fontes livres e os guiões vão para o git)
docs/video/*.mp4
docs/video/*.png
docs/video/amostras_voz/
saida_videos/
