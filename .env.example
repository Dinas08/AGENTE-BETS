# Copia este ficheiro para ".env" e cola a tua chave (dashboard.api-football.com -> Account -> My Access)
API_FOOTBALL_KEY=
# Pedidos que ficam sempre por gastar (plano grátis = 100/dia)
API_FOOTBALL_RESERVE=5
# Opcional: palavra-passe para abrir a dashboard (recomendado se a abrires no telemóvel/rede)
DASHBOARD_PASSWORD=
